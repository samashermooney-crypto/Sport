{
  "entry": [
    "server/src/main.ts",
    "server/src/worker.ts",
    "web/src/main.tsx",
    "db/seeds/index.ts",
    "scripts/openapi.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.spec.ts"
  ],
  "project": [
    "shared/src/**/*.{ts,tsx}",
    "server/src/**/*.{ts,tsx}",
    "web/src/**/*.{ts,tsx}",
    "db/seeds/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": ["legacy/**"],
  "ignoreDependencies": ["kysely-codegen"],
  "ignoreExportsUsedInFile": { "type": true, "interface": true },
  "ignoreIssues": {
    "server/src/db/types.ts": ["exports", "types"],
    "server/src/db/withOrg.ts": ["exports"]
  }
}
