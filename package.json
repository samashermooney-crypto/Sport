{
  "name": "athlentry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --import tsx server/src/main.ts",
    "worker": "node --import tsx server/src/worker.ts",
    "db:up": "node scripts/compose.mjs up -d --wait postgres stripe-mock mailpit",
    "db:down": "node scripts/compose.mjs down",
    "db:migrate": "node --import tsx server/src/db/migrate.ts && npm run db:codegen",
    "db:codegen": "node scripts/db-codegen.mjs",
    "db:seed": "node --import tsx db/seeds/index.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tools.json --pretty false",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc -b --pretty false && vite build",
    "openapi": "node --import tsx scripts/openapi.ts",
    "registry": "node --import tsx scripts/registry.mjs",
    "gen:module": "node scripts/gen-module.mjs",
    "size": "size-limit",
    "knip": "knip",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@node-rs/argon2": "^2.2.1",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@tanstack/react-query": "^5.104.0",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "express": "^5.2.1",
    "i18next": "^26.4.2",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "pg-boss": "^12.1.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-is": "19.2.4",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "stripe": "22.6.2",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@size-limit/file": "^11.2.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.10.2",
    "jsdom": "^27.3.0",
    "knip": "^5.83.0",
    "kysely-codegen": "^0.20.0",
    "lint-staged": "^16.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^11.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,css,json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck"
  },
  "size-limit": [
    {
      "path": "dist/web/assets/app-*.js",
      "gzip": true,
      "limit": "200 KB"
    }
  ]
}
