# Local development uses trust-authenticated PostgreSQL bound to 127.0.0.1.
NODE_ENV=development
APP_URL=http://127.0.0.1:5173
APP_DOMAIN=127.0.0.1
DATABASE_URL=postgres://athlentry_app@127.0.0.1:5432/athlentry_dev
DATABASE_ADMIN_URL=postgres://athlentry_admin@127.0.0.1:5432/athlentry_dev
# Connections per API/worker process (default 20).
DATABASE_POOL_MAX=20
PORT=3001
DELIVERY_MODE=preview
# Parallel email/SMS/push sends per campaign drain run (default 4; stay within provider rate limits).
COMMUNICATIONS_SEND_CONCURRENCY=4
LOG_LEVEL=info
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
SESSION_SECRET=
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KID=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RESEND_API_KEY=
MAIL_FROM=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CHECKR_API_KEY=
SENTRY_DSN=
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
LEGAL_DOCS_APPROVED=false
